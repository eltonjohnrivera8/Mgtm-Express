{
  "name": "mgtm-express-backend",
  "version": "1.0.0",
  "description": "MGTM Express — Personal Delivery Partner sa Mangatarem, Pangasinan",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
