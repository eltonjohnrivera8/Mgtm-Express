# ═══════════════════════════════════════════════════════════════
# MGTM EXPRESS — ENVIRONMENT VARIABLES
# Personal Delivery Partner sa Mangatarem, Pangasinan
# ═══════════════════════════════════════════════════════════════
# PANUTO:
#   1. Kopyahin ang file na ito bilang ".env"
#   2. Palitan ang lahat ng "your_..." ng tunay na values
#   3. HUWAG i-commit ang .env sa Git (nasa .gitignore na)
# ═══════════════════════════════════════════════════════════════

# ── DATABASE ────────────────────────────────────────────────────
# Local development:
DATABASE_URL="postgresql://postgres:password@localhost:5432/mgtm_express_db"
# Railway production (hahanapin mo sa Railway Dashboard):
# DATABASE_URL="postgresql://postgres:xxxxx@roundhouse.proxy.rlwy.net:xxxxx/railway"

# ── SERVER ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── URLS ────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
APP_URL=http://localhost:5173
# Production:
# FRONTEND_URL=https://mgtm-express.vercel.app
# BACKEND_URL=https://mgtm-express-backend.railway.app
# APP_URL=https://mgtm-express.vercel.app

# ── BUSINESS INFO (Default — mababago sa Admin Panel) ───────────
BUSINESS_NAME="MGTM Express"
BUSINESS_TAGLINE="Personal Delivery Partner sa Mangatarem, Pangasinan"
BUSINESS_PHONE="+639319711028"
BUSINESS_EMAIL="mgtmexpress@gmail.com"

# ── RESTAURANT / HUB LOCATION ───────────────────────────────────
# Default hub sa Mangatarem, Pangasinan
# Para makuha ang exact coords: buksan ang Google Maps →
#   right-click sa location → kopyahin ang coordinates
HUB_LAT=15.7933
HUB_LNG=120.2072
HUB_ADDRESS="Mangatarem, Pangasinan"

# ── PRICING ENGINE (Default — mababago sa Admin Panel) ──────────
# Formula: (distance_km * RATE_PER_KM) + BASE_FEE
# Minimum: MINIMUM_FEE para sa unang 1 km
RATE_PER_KM=18
BASE_FEE=20
MINIMUM_FEE=55
ADDITIONAL_STORE_FEE=15

# ── OPERATING HOURS (Default — mababago sa Admin Panel) ─────────
OPERATING_HOURS_OPEN=08:00
OPERATING_HOURS_CLOSE=21:00
OPERATING_DAYS="Monday,Tuesday,Wednesday,Thursday,Friday,Saturday,Sunday"

# ── JWT AUTHENTICATION ───────────────────────────────────────────
# MAHALAGA: Palitan ng mahabang random string sa production!
# Para gumawa: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=mgtm_express_jwt_secret_palitan_ito_ng_random_string_2026
JWT_EXPIRES_IN=7d

# ── OTP SETTINGS ────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=5
# Sa development, lalabas ang OTP sa console (hindi magpapadala ng SMS)
# Sa production, gamitin ang Semaphore
SEMAPHORE_API_KEY=your_semaphore_api_key_here
SEMAPHORE_SENDER_NAME=MGTM

# ── PAYMONGO ────────────────────────────────────────────────────
# Sign up: https://dashboard.paymongo.com
# Test keys (para sa development):
PAYMONGO_SECRET_KEY=sk_test_your_paymongo_secret_key_here
PAYMONGO_PUBLIC_KEY=pk_test_your_paymongo_public_key_here
# Webhook Secret (makukuha sa PayMongo Dashboard → Developers → Webhooks):
PAYMONGO_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ── EMAIL (Resend — https://resend.com) ──────────────────────────
# Para sa email receipts at notifications
# Sign up: https://resend.com (may libreng tier: 100 emails/day)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="MGTM Express <noreply@mgtmexpress.ph>"

# ── ANALYTICS (Optional) ────────────────────────────────────────
# Google Analytics Measurement ID (e.g. G-XXXXXXXXXX)
GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Mixpanel Project Token
MIXPANEL_TOKEN=your_mixpanel_token_here

# ── SUBSCRIPTION PRICING ────────────────────────────────────────
SUBSCRIPTION_MONTHLY_PRICE=1499
SUBSCRIPTION_YEARLY_PRICE=15289.80

# ── SECURITY ────────────────────────────────────────────────────
# Rate limiting: ilang requests ang pinapayagan per IP per 15 minutes
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# ── ADMIN ACCOUNT (para sa initial setup) ───────────────────────
ADMIN_PHONE=09319711028
ADMIN_NAME="MGTM Admin"
ADMIN_EMAIL=admin@mgtmexpress.ph

# ── FILE UPLOADS ─────────────────────────────────────────────────
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads
